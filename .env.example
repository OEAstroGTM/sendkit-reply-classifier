# SendKit workspace API key (sk_...)
SENDKIT_API_KEY=

# Anthropic API key for Claude classification (get one at console.anthropic.com)
ANTHROPIC_API_KEY=

# Any random string — protects /api/setup and /api/classify-test
SETUP_SECRET=

# Optional: HMAC secret for webhook signature verification.
# Leave blank on first setup; /api/setup will show you the generated one to add.
SENDKIT_WEBHOOK_SECRET=

# Optional: set to "true" to reject webhooks with bad/missing signatures
STRICT_SIGNATURE=

# Optional: Google Apps Script web app URL for sheet logging
SHEETS_WEBHOOK_URL=

# Optional: only needed if using a platform key (sk_user_...)
SENDKIT_WORKSPACE_ID=

# Optional: override the Claude model (default claude-haiku-4-5)
CLAUDE_MODEL=
