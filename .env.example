# SendKit workspace API key (sk_...)
SENDKIT_API_KEY=

# Anthropic API key for Claude classification (get one at console.anthropic.com)
ANTHROPIC_API_KEY=

# Any random string — protects /api/setup and /api/classify-test
SETUP_SECRET=

# Optional: HMAC secret for webhook signature verification.
# Leave blank on first setup; /api/setup will show you the generated one to add.
SENDKIT_WEBHOOK_SECRET=

# Optional: set to "true" to reject webhooks with bad/missing signatures
STRICT_SIGNATURE=

# Optional: Google Apps Script web app URL for sheet logging
SHEETS_WEBHOOK_URL=

# Optional: only needed if using a platform key (sk_user_...)
SENDKIT_WORKSPACE_ID=

# Optional: override the Claude model (default claude-haiku-4-5)
CLAUDE_MODEL=

# ---------- AI replies with calendar times (Nylas) ----------

# Nylas API key (nyk_...) — enables AI replies proposing meeting times.
# Your calendar account must be connected as a grant in the Nylas dashboard.
NYLAS_API_KEY=

# Optional: pin a specific grant instead of auto-detecting the first one
NYLAS_GRANT_ID=
NYLAS_GRANT_EMAIL=

# Optional: Nylas region — "us" (default) or "eu"
NYLAS_REGION=

# Personalization
SENDER_NAME=
COMPANY_URL=
# Facts the AI may use when answering "more info" / pricing questions.
# The AI will NOT invent anything beyond these notes.
PRODUCT_NOTES=

# Availability window (defaults shown)
TIMEZONE=America/New_York
WORK_START=9:00
WORK_END=17:00
MEETING_MINUTES=30
MIN_NOTICE_HOURS=20
LOOKAHEAD_DAYS=7

# Behavior (defaults shown). Categories not in REPLY_CATEGORIES are tag-only.
# AUTOSEND categories send immediately; other reply categories save a draft.
REPLY_CATEGORIES=Interested,Meeting Request,More Info Needed,Pricing Question
AUTOSEND_CATEGORIES=Meeting Request

# Follow-up bumps: days after a sent reply (weekends shift to Monday).
# Cancelled automatically when the lead replies or books. Empty disables.
FOLLOWUP_DAYS=3,7
